{
    "name": "silverstripe/installer",
    "type": "silverstripe-recipe",
    "description": "The SilverStripe Framework Installer",
    "require": {
        "php": "^8.3",
        "silverstripe/vendor-plugin": "^3.0",
        "silverstripe/recipe-cms": "^6.3",
        "silverstripe-themes/simple": "^3.3",
        "silverstripe/login-forms": "^6.3",
        "dnadesign/silverstripe-elemental": "^6.3",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "wernerkrauss/silverstripe-rector": "^1",
        "phpunit/phpunit": "^11.5",
        "silverstripeltd/bespoke-standards": "^1.4"
    },
    "extra": {
        "project-files-installed": [
            ".htaccess",
            "app/.htaccess",
            "app/_config/mimevalidator.yml",
            "app/_config/mysite.yml",
            "app/src/Page.php",
            "app/src/PageController.php"
        ],
        "public-files-installed": [
            ".htaccess",
            "index.php",
            "web.config"
        ],
        "expose": [
            "themes/app/dist"
        ]
    },
    "config": {
        "process-timeout": 600,
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "phpcs": "bespoke-phpcs",
        "phpcbf": "bespoke-phpcbf"
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}
